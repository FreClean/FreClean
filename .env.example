# Production-safe examples only. Replace with real values in each environment.
# Required values are enforced in production.

# --- Runtime ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (server-only) ---
# Purpose: PostgreSQL connection string for the authoritative Core API database.
# Required: yes, in production.
# Environment: development, staging, production.
# Validation: fail fast if missing or empty in production.
DATABASE_URL=postgres://freclean:freclean@localhost:5432/freclean_dev

# --- Authentication (server-only) ---
# Purpose: sign access and refresh tokens used by the core API.
# Required: yes, in production.
# Environment: development, staging, production.
# Validation: fail fast if missing or shorter than 32 chars in production.
JWT_ACCESS_SECRET=replace-with-32-plus-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Card payments (server-only) ---
# Purpose: authenticate processor API calls and verify signed webhook payloads.
# Required: yes, in production.
# Environment: staging, production.
# Validation: fail fast if missing or too short in production.
CARD_PROCESSOR_API_KEY=replace-with-processor-api-key
CARD_PROCESSOR_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# --- Crypto payments (server-only) ---
# Purpose: verify on-chain CELO and USDm transactions before marking a payment as valid.
# Required: yes, in production.
# Environment: staging, production.
# Validation: fail fast if missing or empty.
CELO_RPC_URL=https://forno.celo.org
USDM_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CELO_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
MIN_CONFIRMATIONS=3

# --- Operational integrations (server-only) ---
# Purpose: outbound notifications and operational events.
# Required: optional unless the feature is enabled.
# Environment: staging, production.
SMTP_URL=smtp://user:password@smtp.example.com:587
SMS_PROVIDER_API_KEY=replace-with-provider-key

# --- Public configuration notes ---
# The app and website must never receive any of the above secrets directly.
# CORS_ORIGIN is the approved list of client origins that may call the core API.
# Do not commit a real .env file. Keep secrets in the target environment secret store.
