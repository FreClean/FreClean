# --- App ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgres://freclean:freclean@localhost:5432/freclean_dev

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Card payments (secure processor, e.g. Stripe) ---
CARD_PROCESSOR_API_KEY=
CARD_PROCESSOR_WEBHOOK_SECRET=

# --- Crypto payments (CeloHT dApp integration) ---
CELO_RPC_URL=
CELOHT_VERIFY_WEBHOOK_SECRET=
CUSD_CONTRACT_ADDRESS=
CELO_RECEIVING_ADDRESS=
MIN_CONFIRMATIONS=3

# --- Notifications ---
SMTP_URL=
SMS_PROVIDER_API_KEY=

# Never commit a real .env file. This file only documents required variables.
