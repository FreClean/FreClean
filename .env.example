# Production-safe examples only. Replace with real values in each environment.
# Required values are enforced in production.

# --- Runtime ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
ENQUIRY_SPAM_SECRET=replace-with-32-plus-char-random-hmac-secret
# Purpose: HMAC key used only to detect repeated public enquiry submissions.
# Required: yes, in production.
# Environment: development, staging, production.
# Validation: fail fast if missing or shorter than 32 chars in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address for Resend; keep this server-side.
RESEND_FROM_EMAIL=FreClean <enquiries@freclean.com>
# Official recipient for customer enquiry notifications.
CONTACT_EMAIL=contact@freclean.com

# --- Database (server-only) ---
# Purpose: PostgreSQL connection string for the authoritative Core API database.
# Required: yes, in production.
# Environment: development, staging, production.
# Validation: fail fast if missing or empty in production.
DATABASE_URL=postgres://freclean:freclean@localhost:5432/freclean_dev
# Required when DATABASE_URL points to Supabase PostgreSQL.
# Use the trusted PEM-encoded CA certificate from the Supabase database connection settings.
# Paste the certificate contents, including the BEGIN/END CERTIFICATE lines. Never use a private key.
SUPABASE_CA_CERT=

# --- Authentication (server-only) ---
# Purpose: sign access and refresh tokens used by the core API.
# Required: yes, in production.
# Environment: development, staging, production.
# Validation: fail fast if missing or shorter than 32 chars in production.
JWT_ACCESS_SECRET=replace-with-32-plus-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- USDT payments (server-only) ---
# Safe default: leave disabled until mainnet RPCs and token identifiers are verified.
USDT_PAYMENTS_ENABLED=false
BSC_RPC_URL=https://your-bnb-smart-chain-rpc.example
TRON_RPC_URL=https://your-tron-rpc.example
SOLANA_RPC_URL=https://your-solana-rpc.example
CELO_RPC_URL=https://forno.celo.org
TRONGRID_API_KEY=
# Required to expose the separate CeloHT DApp option.
CELOHT_DAPP_URL=
# Official identifiers used by server-side verification:
# BNB Smart Chain: 0x55d398326f99059ff775485246999027b3197955
# TRON: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Solana: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# Celo: 0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e
# Confirm the BNB Smart Chain identifier against authoritative sources before enabling.

# --- Public configuration notes ---
# The website must never receive any of the above secrets directly.
# CORS_ORIGIN is the approved list of client origins that may call the core API.
# Do not commit a real .env file. Keep secrets in the target environment secret store.
